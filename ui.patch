--- /dev/null
+++ b/scripts/setup.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if ! command -v pnpm >/dev/null 2>&1; then
+  echo "pnpm is required. Install pnpm 9+ before continuing." >&2
+  exit 1
+fi
+
+pnpm install
+
+env_file=".env.local"
+example_file=".env.example"
+
+if [[ ! -f "$env_file" && -f "$example_file" ]]; then
+  cp "$example_file" "$env_file"
+  echo "Created $env_file from template. Update it with your secrets." >&2
+fi
+
+echo "Setup complete."
diff --git a/scripts/verify-manifest.mjs b/scripts/verify-manifest.mjs
new file mode 100755
index 0000000000000000000000000000000000000000..2934142881f71ed12407ee461579da7817515242
--- /dev/null
+++ b/scripts/verify-manifest.mjs
@@ -0,0 +1,51 @@
+#!/usr/bin/env node
+
+import { existsSync } from "node:fs";
+import { resolve } from "node:path";
+
+const routePath = resolve(".next", "server", "app", ".well-known", "farcaster.json", "route.js");
+
+if (!existsSync(routePath)) {
+  console.error("Manifest route not found at", routePath);
+  process.exit(1);
+}
+
+const imported = await import(routePath);
+const module = imported.default ?? imported;
+const userland = module?.routeModule?.userland ?? module?.userland;
+const handler = userland?.GET ?? module?.GET;
+
+if (typeof handler !== "function") {
+  console.error("Manifest route does not expose a GET handler");
+  process.exit(1);
+}
+
+const response = await handler();
+const manifest = await response.json();
+
+const required = [
+  "miniapp.version",
+  "miniapp.name",
+  "miniapp.subtitle",
+  "miniapp.description",
+  "miniapp.iconUrl",
+  "miniapp.splashImageUrl",
+  "miniapp.ogImageUrl",
+  "miniapp.screenshotUrls",
+  "miniapp.homeUrl",
+  "miniapp.webhookUrl",
+];
+
+for (const key of required) {
+  const parts = key.split(".");
+  let pointer = manifest;
+  for (const part of parts) {
+    pointer = pointer?.[part];
+  }
+  if (!pointer || (Array.isArray(pointer) && pointer.length === 0)) {
+    console.error(`Manifest missing required field: ${key}`);
+    process.exit(1);
+  }
+}
+
+console.log("✅ Farcaster manifest verified");
