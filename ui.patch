@@ -0,0 +1,205 @@
+import { createHmac, timingSafeEqual } from "node:crypto";
+
+import { z } from "zod";
+
+import { env } from "@/lib/env";
+
+const BASE_PAY_API_URL = "https://api.developer.coinbase.com/base-pay/v1";
+const SIGNATURE_HEADER = "x-basepay-signature";
+
+const baseSessionSchema = z.object({
+  id: z.string(),
+  amountWei: z.string(),
+  status: z.string(),
+  checkoutUrl: z.string().url().optional(),
+  redirectUrl: z.string().url().optional(),
+});
+
+const createSessionResponseSchema = baseSessionSchema.transform((payload) => {
+  const checkoutUrl = payload.checkoutUrl ?? payload.redirectUrl;
+  if (!checkoutUrl) {
+    throw new Error("Missing checkout URL in Base Pay response");
+  }
+  return {
+    id: payload.id,
+    checkoutUrl,
+    amountWei: payload.amountWei,
+    status: payload.status,
+  };
+});
+
+const webhookEventSchema = z.object({
+  type: z.string(),
+  data: z.object({
+    id: z.string(),
+    sessionId: z.string().optional(),
+    status: z.string(),
+    amountWei: z.string(),
+    network: z.string().optional(),
+    recipient: z.string().optional(),
+    sku: z.string().optional(),
+  }),
+});
+
+type SessionLedgerEntry = {
+  sku: string;
+  amountWei: bigint;
+  createdAt: number;
+};
+
+type GrantedEntry = {
+  grantedAt: number;
+};
+
+const sessionLedger = new Map<string, SessionLedgerEntry>();
+const grantedSessions = new Map<string, GrantedEntry>();
+
+export function rememberSession(sessionId: string, entry: SessionLedgerEntry) {
+  sessionLedger.set(sessionId, entry);
+}
+
+export function markSessionGranted(sessionId: string) {
+  grantedSessions.set(sessionId, { grantedAt: Date.now() });
+}
+
+export function isSessionGranted(sessionId: string): boolean {
+  return grantedSessions.has(sessionId);
+}
+
+export function getSessionLedgerEntry(sessionId: string) {
+  return sessionLedger.get(sessionId);
+}
+
+export function normaliseAmountWei(amountWei?: bigint | null) {
+  const minimum = env.server.MIN_PRICE_WEI;
+  if (!amountWei || amountWei < minimum) {
+    if (amountWei && amountWei < minimum) {
+      console.warn(
+        `Requested amount ${amountWei.toString()} wei is below MIN_PRICE_WEI (${minimum.toString()}). Using minimum.`,
+      );
+    }
+    return { amountWei: minimum, bumped: true } as const;
+  }
+  return { amountWei, bumped: false } as const;
+}
+
+export type BasePaySession = z.infer<typeof createSessionResponseSchema>;
+
+export async function createBasePaySession(params: {
+  sku: string;
+  amountWei?: bigint;
+}): Promise<BasePaySession> {
+  const { amountWei: requestedAmount } = normaliseAmountWei(params.amountWei ?? env.server.MIN_PRICE_WEI);
+  const headers: Record<string, string> = {
+    "content-type": "application/json",
+    authorization: `Bearer ${env.server.BASE_PAY_API_KEY}`,
+  };
+  if (env.server.BASE_PAY_APP_ID) {
+    headers["x-base-pay-app-id"] = env.server.BASE_PAY_APP_ID;
+  }
+  if (env.server.BASE_PAY_PUBLIC_KEY) {
+    headers["x-base-pay-public-key"] = env.server.BASE_PAY_PUBLIC_KEY;
+  }
+
+  const response = await fetch(`${BASE_PAY_API_URL}/sessions`, {
+    method: "POST",
+    headers,
+    body: JSON.stringify({
+      sku: params.sku,
+      amountWei: requestedAmount.toString(),
+      webhookUrl: env.public.NEXT_PUBLIC_WEBHOOK_URL,
+      successUrl: `${env.public.NEXT_PUBLIC_URL}/?success=true`,
+      cancelUrl: `${env.public.NEXT_PUBLIC_URL}/?canceled=true`,
+    }),
+  });
+
+  if (!response.ok) {
+    const errorText = await response.text();
+    console.error("Failed to create Base Pay session", response.status, errorText);
+    throw new Error("Failed to create Base Pay session");
+  }
+
+  const payload = await response.json();
+  const session = createSessionResponseSchema.parse(payload);
+  rememberSession(session.id, {
+    sku: params.sku,
+    amountWei: requestedAmount,
+    createdAt: Date.now(),
+  });
+  return session;
+}
+
+export function signatureHeaderName() {
+  return SIGNATURE_HEADER;
+}
+
+export function verifyBasePaySignature(signatureHeader: string | null, rawBody: Buffer): boolean {
+  if (!signatureHeader) {
+    return false;
+  }
+
+  const hmac = createHmac("sha256", env.server.BASE_PAY_WEBHOOK_SECRET);
+  hmac.update(rawBody);
+  const expected = Buffer.from(hmac.digest("hex"), "hex");
+
+  let received: Buffer;
+  try {
+    received = Buffer.from(signatureHeader, "hex");
+  } catch (error) {
+    console.error("Invalid signature header", error);
+    return false;
+  }
+
+  if (expected.length !== received.length) {
+    return false;
+  }
+
+  return timingSafeEqual(expected, received);
+}
+
+export function parseWebhookEvent(rawBody: Buffer) {
+  const asString = rawBody.toString("utf8");
+  let json: unknown;
+  try {
+    json = JSON.parse(asString);
+  } catch (error) {
+    console.error("Failed to parse webhook body", error);
+    throw new Error("INVALID_JSON");
+  }
+  return webhookEventSchema.parse(json);
+}
+
+export function validateSuccessfulPayment(event: z.infer<typeof webhookEventSchema>) {
+  const { data } = event;
+  const sessionId = data.sessionId ?? data.id;
+  if (!sessionId) {
+    throw new Error("MISSING_SESSION_ID");
+  }
+
+  const ledgerEntry = getSessionLedgerEntry(sessionId);
+  if (!ledgerEntry) {
+    throw new Error("UNKNOWN_SESSION");
+  }
+
+  const amountWei = BigInt(data.amountWei);
+  if (amountWei < env.server.MIN_PRICE_WEI) {
+    throw new Error("UNDERPAID");
+  }
+
+  if (amountWei < ledgerEntry.amountWei) {
+    throw new Error("AMOUNT_MISMATCH");
+  }
+
+  if (env.server.PAY_TO_ADDRESS && data.recipient) {
+    if (data.recipient.toLowerCase() !== env.server.PAY_TO_ADDRESS) {
+      throw new Error("WRONG_RECIPIENT");
+    }
+  }
+
+  const network = data.network?.toLowerCase();
+  if (network && network !== "base-mainnet" && network !== "base") {
+    throw new Error("WRONG_NETWORK");
+  }
+
+  return sessionId;
+}
