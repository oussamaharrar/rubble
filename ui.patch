@@ -0,0 +1,115 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+
+import { BOOSTER_DURATION_MS } from "@/lib/base";
+import { BubbleGameCanvas } from "@/app/game/BubbleGameCanvas";
+import { PayButton, type PayButtonSession } from "@/components/PayButton";
+
+type StatusResponse = {
+  granted: boolean;
+};
+
+type GameClientProps = {
+  webhookLabel: string;
+};
+
+const POLL_INTERVAL_MS = 3_500;
+
+export function GameClient({ webhookLabel }: GameClientProps) {
+  const [boosterActive, setBoosterActive] = useState(false);
+  const [statusMessage, setStatusMessage] = useState(
+    "Purchase Time Freeze to slow down rising bubbles.",
+  );
+  const [pendingSessionId, setPendingSessionId] = useState<string | null>(null);
+  const [boosterRemainingMs, setBoosterRemainingMs] = useState(0);
+  const boosterExpiryRef = useRef(0);
+
+  const activateBooster = useCallback(() => {
+    boosterExpiryRef.current = Date.now() + BOOSTER_DURATION_MS;
+    setBoosterActive(true);
+    setBoosterRemainingMs(BOOSTER_DURATION_MS);
+    setStatusMessage("Time Freeze active! Ride the combo.");
+  }, []);
+
+  useEffect(() => {
+    if (!boosterActive) {
+      return;
+    }
+    const interval = window.setInterval(() => {
+      const remaining = Math.max(0, boosterExpiryRef.current - Date.now());
+      setBoosterRemainingMs(remaining);
+      if (remaining <= 0) {
+        setBoosterActive(false);
+        setStatusMessage("Booster expired. Grab another Time Freeze to push your score.");
+        window.clearInterval(interval);
+      }
+    }, 100);
+
+    return () => window.clearInterval(interval);
+  }, [boosterActive]);
+
+  useEffect(() => {
+    if (!pendingSessionId) {
+      return undefined;
+    }
+
+    let cancelled = false;
+
+    const poll = async () => {
+      try {
+        const response = await fetch(`/api/pay/status?sessionId=${pendingSessionId}`, {
+          cache: "no-store",
+        });
+        if (!response.ok) {
+          return;
+        }
+        const payload: StatusResponse = await response.json();
+        if (!cancelled && payload.granted) {
+          activateBooster();
+          setPendingSessionId(null);
+        }
+      } catch (error) {
+        console.error("Failed to poll payment status", error);
+      }
+    };
+
+    poll();
+    const interval = window.setInterval(poll, POLL_INTERVAL_MS);
+
+    return () => {
+      cancelled = true;
+      window.clearInterval(interval);
+    };
+  }, [activateBooster, pendingSessionId]);
+
+  const handleSessionCreated = useCallback((session: PayButtonSession) => {
+    setPendingSessionId(session.id);
+    setStatusMessage("Complete the Base Pay checkout to arm your Time Freeze.");
+  }, []);
+
+  const boosterDurationSeconds = Math.round(BOOSTER_DURATION_MS / 1_000);
+
+  return (
+    <div className="game-card">
+      <div>
+        <strong>Daily Hunt</strong>
+        <div className="game-card__legend">
+          <span>Tap to pop shimmering bubbles. Keep your combo alive for massive scores.</span>{" "}
+          <span>
+            Time Freeze slows the board for {boosterDurationSeconds} seconds after Base Pay clears.
+          </span>
+        </div>
+      </div>
+      <BubbleGameCanvas boosterActive={boosterActive} />
+      <div className="miniapp-shell__footer">
+        <PayButton onSessionCreated={handleSessionCreated} />
+        <div className="pay-button__status">
+          {statusMessage}
+          {boosterActive ? ` (${Math.ceil(boosterRemainingMs / 1_000)}s left)` : ""}
+        </div>
+        <div className="pay-button__status">Webhook: {webhookLabel}</div>
+      </div>
+    </div>
+  );
+}
