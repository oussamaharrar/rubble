+import { z } from "zod";
+
+const addressSchema = z
+  .string()
+  .regex(/^0x[a-fA-F0-9]{40}$/u, "Must be a valid EVM address");
+
+const envSchema = z.object({
+  NEXT_PUBLIC_URL: z.string().url(),
+  NEXT_PUBLIC_WEBHOOK_URL: z.string().url(),
+  BASE_RPC_URL: z.string().url(),
+  PAY_TO_ADDRESS: addressSchema,
+  MIN_PRICE_WEI: z.coerce.bigint().refine((value) => value > 0n, {
+    message: "MIN_PRICE_WEI must be greater than zero",
+  }),
+  BASE_PAY_API_KEY: z.string().min(1),
+  BASE_PAY_WEBHOOK_SECRET: z.string().min(1),
+  BASE_PAY_APP_ID: z.string().min(1).optional(),
+  BASE_PAY_PUBLIC_KEY: z.string().min(1).optional(),
+  BASE_BUILDER_OWNER_ADDRESS: addressSchema.optional(),
+});
+
+const rawEnv = {
+  NEXT_PUBLIC_URL: process.env.NEXT_PUBLIC_URL,
+  NEXT_PUBLIC_WEBHOOK_URL: process.env.NEXT_PUBLIC_WEBHOOK_URL,
+  BASE_RPC_URL: process.env.BASE_RPC_URL,
+  PAY_TO_ADDRESS: process.env.PAY_TO_ADDRESS,
+  MIN_PRICE_WEI: process.env.MIN_PRICE_WEI,
+  BASE_PAY_API_KEY: process.env.BASE_PAY_API_KEY,
+  BASE_PAY_WEBHOOK_SECRET: process.env.BASE_PAY_WEBHOOK_SECRET,
+  BASE_PAY_APP_ID: process.env.BASE_PAY_APP_ID,
+  BASE_PAY_PUBLIC_KEY: process.env.BASE_PAY_PUBLIC_KEY,
+  BASE_BUILDER_OWNER_ADDRESS: process.env.BASE_BUILDER_OWNER_ADDRESS,
+};
+
+const parsedEnv = envSchema.safeParse(rawEnv);
+
+if (!parsedEnv.success) {
+  console.error("❌ Invalid environment configuration", parsedEnv.error.flatten().fieldErrors);
+  throw new Error("Missing or invalid environment variables. See logs for details.");
+}
+
+const {
+  NEXT_PUBLIC_URL,
+  NEXT_PUBLIC_WEBHOOK_URL,
+  BASE_RPC_URL,
+  PAY_TO_ADDRESS,
+  MIN_PRICE_WEI,
+  BASE_PAY_API_KEY,
+  BASE_PAY_WEBHOOK_SECRET,
+  BASE_PAY_APP_ID,
+  BASE_PAY_PUBLIC_KEY,
+  BASE_BUILDER_OWNER_ADDRESS,
+} = parsedEnv.data;
+
+export const publicEnv = Object.freeze({
+  NEXT_PUBLIC_URL,
+  NEXT_PUBLIC_WEBHOOK_URL,
+});
+
+export const serverEnv = Object.freeze({
+  NEXT_PUBLIC_URL,
+  NEXT_PUBLIC_WEBHOOK_URL,
+  BASE_RPC_URL,
+  PAY_TO_ADDRESS: PAY_TO_ADDRESS.toLowerCase(),
+  MIN_PRICE_WEI,
+  BASE_PAY_API_KEY,
+  BASE_PAY_WEBHOOK_SECRET,
+  BASE_PAY_APP_ID: BASE_PAY_APP_ID ?? null,
+  BASE_PAY_PUBLIC_KEY: BASE_PAY_PUBLIC_KEY ?? null,
+  BASE_BUILDER_OWNER_ADDRESS: BASE_BUILDER_OWNER_ADDRESS?.toLowerCase() ?? null,
+});
+
+export const env = {
+  public: publicEnv,
+  server: serverEnv,
+} as const;
+
+export type PublicEnv = typeof publicEnv;
+export type ServerEnv = typeof serverEnv;
