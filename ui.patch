diff --git a/app/game/BubbleGameCanvas.tsx b/app/game/BubbleGameCanvas.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..daf9eb5cf8a1b603c8011b34488eec3f5d9c65aa
--- /dev/null
+++ b/app/game/BubbleGameCanvas.tsx
@@ -0,0 +1,243 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+
+import { BOOSTER_SLOW_FACTOR } from "@/lib/base";
+
+import "./styles.css";
+
+type Bubble = {
+  id: number;
+  x: number;
+  y: number;
+  radius: number;
+  speed: number;
+  hue: number;
+  wobbleOffset: number;
+};
+
+type BubbleGameCanvasProps = {
+  boosterActive: boolean;
+};
+
+const BASE_BUBBLE_SPEED = 68;
+const MAX_COMBO = 10;
+const SPAWN_INTERVAL_MS = 780;
+
+export function BubbleGameCanvas({ boosterActive }: BubbleGameCanvasProps) {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const animationRef = useRef<number | null>(null);
+  const bubblesRef = useRef<Bubble[]>([]);
+  const nextIdRef = useRef(0);
+  const lastSpawnRef = useRef(0);
+  const comboRef = useRef(1);
+  const scoreRef = useRef(0);
+  const difficultyRef = useRef(1);
+  const boosterActiveRef = useRef(boosterActive);
+
+  const [score, setScore] = useState(0);
+  const [combo, setCombo] = useState(1);
+  const [fps, setFps] = useState(0);
+
+  useEffect(() => {
+    boosterActiveRef.current = boosterActive;
+  }, [boosterActive]);
+
+  const spawnBubble = useCallback(
+    (canvasWidth: number, canvasHeight: number) => {
+      const radius = 22 + Math.random() * 22;
+      const x = radius + Math.random() * (canvasWidth - radius * 2);
+      const y = canvasHeight + radius;
+      const speed = BASE_BUBBLE_SPEED + Math.random() * 32 * difficultyRef.current;
+      const hue = 180 + Math.random() * 140;
+      const wobbleOffset = Math.random() * Math.PI * 2;
+      const bubble: Bubble = {
+        id: nextIdRef.current++,
+        x,
+        y,
+        radius,
+        speed,
+        hue,
+        wobbleOffset,
+      };
+      bubblesRef.current.push(bubble);
+    },
+    [],
+  );
+
+  const resizeCanvas = useCallback(() => {
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    const context = canvas.getContext("2d");
+    if (!context) return;
+    const { width, height } = canvas.getBoundingClientRect();
+    const pixelRatio = window.devicePixelRatio ?? 1;
+    canvas.width = Math.round(width * pixelRatio);
+    canvas.height = Math.round(height * pixelRatio);
+    if (typeof context.resetTransform === "function") {
+      context.resetTransform();
+    }
+    context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
+  }, []);
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (!canvas) {
+      return;
+    }
+    const context = canvas.getContext("2d");
+    if (!context) {
+      return;
+    }
+
+    resizeCanvas();
+
+    const handleResize = () => resizeCanvas();
+    window.addEventListener("resize", handleResize);
+
+    let lastTimestamp = performance.now();
+    let frameCounter = 0;
+    let fpsAccumulator = 0;
+
+    const loop = (timestamp: number) => {
+      const deltaMs = Math.min(50, timestamp - lastTimestamp);
+      lastTimestamp = timestamp;
+      frameCounter += 1;
+      fpsAccumulator += deltaMs;
+      if (fpsAccumulator >= 1_000) {
+        setFps(Math.round((frameCounter * 1_000) / fpsAccumulator));
+        fpsAccumulator = 0;
+        frameCounter = 0;
+      }
+
+      const { width, height } = canvas.getBoundingClientRect();
+
+      context.clearRect(0, 0, width, height);
+
+      const activeSpeedFactor = boosterActiveRef.current ? BOOSTER_SLOW_FACTOR : 1;
+      const spawnInterval = Math.max(260, SPAWN_INTERVAL_MS - difficultyRef.current * 45);
+
+      if (timestamp - lastSpawnRef.current > spawnInterval) {
+        lastSpawnRef.current = timestamp;
+        spawnBubble(width, height);
+      }
+
+      bubblesRef.current = bubblesRef.current.filter((bubble) => {
+        const wobble = Math.sin(timestamp / 600 + bubble.wobbleOffset) * 8;
+        const speed = bubble.speed * (0.0016 * deltaMs) * activeSpeedFactor;
+        bubble.y -= speed;
+        bubble.x += wobble * 0.035;
+
+        if (bubble.y + bubble.radius < -24) {
+          comboRef.current = 1;
+          setCombo(1);
+          return false;
+        }
+        drawBubble(context, bubble);
+        return true;
+      });
+
+      if (boosterActiveRef.current) {
+        context.save();
+        context.fillStyle = "rgba(75, 226, 255, 0.10)";
+        context.fillRect(0, 0, width, height);
+        context.restore();
+      }
+
+      animationRef.current = requestAnimationFrame(loop);
+    };
+
+    animationRef.current = requestAnimationFrame(loop);
+
+    return () => {
+      if (animationRef.current !== null) {
+        cancelAnimationFrame(animationRef.current);
+      }
+      window.removeEventListener("resize", handleResize);
+    };
+  }, [resizeCanvas, spawnBubble]);
+
+  const popBubble = useCallback((bubbleId: number) => {
+    bubblesRef.current = bubblesRef.current.filter((bubble) => bubble.id !== bubbleId);
+    comboRef.current = Math.min(comboRef.current + 1, MAX_COMBO);
+    scoreRef.current += 10 * comboRef.current;
+    difficultyRef.current = Math.min(difficultyRef.current + 0.045, 4.2);
+    setScore(scoreRef.current);
+    setCombo(comboRef.current);
+  }, []);
+
+  const handlePointerDown = useCallback(
+    (event: PointerEvent) => {
+      const canvas = canvasRef.current;
+      if (!canvas) {
+        return;
+      }
+      const rect = canvas.getBoundingClientRect();
+      const x = event.clientX - rect.left;
+      const y = event.clientY - rect.top;
+
+      let hit = false;
+      for (let index = bubblesRef.current.length - 1; index >= 0; index -= 1) {
+        const bubble = bubblesRef.current[index];
+        const dx = x - bubble.x;
+        const dy = y - bubble.y;
+        if (dx * dx + dy * dy <= bubble.radius * bubble.radius) {
+          hit = true;
+          popBubble(bubble.id);
+          break;
+        }
+      }
+
+      if (!hit) {
+        comboRef.current = 1;
+        setCombo(1);
+      }
+    },
+    [popBubble],
+  );
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (!canvas) {
+      return undefined;
+    }
+    canvas.addEventListener("pointerdown", handlePointerDown, { passive: true });
+
+    return () => {
+      canvas.removeEventListener("pointerdown", handlePointerDown);
+    };
+  }, [handlePointerDown]);
+
+  return (
+    <div className="game-card__canvas-wrapper">
+      <canvas ref={canvasRef} width={424} height={520} />
+      <div className="game-card__hud">
+        <span>Score: {score}</span>
+        <span>Combo: ×{combo}</span>
+        <span style={{ fontSize: "0.7rem", color: "rgba(245,246,251,0.55)" }}>FPS: {fps}</span>
+      </div>
+      {boosterActive ? <div className="game-card__booster-indicator">Time Freeze</div> : null}
+    </div>
+  );
+}
+
+function drawBubble(context: CanvasRenderingContext2D, bubble: Bubble) {
+  context.save();
+  context.beginPath();
+  context.translate(bubble.x, bubble.y);
+  const gradient = context.createRadialGradient(0, -bubble.radius * 0.35, bubble.radius * 0.2, 0, 0, bubble.radius);
+  gradient.addColorStop(0, `hsla(${bubble.hue}, 90%, 85%, 0.9)`);
+  gradient.addColorStop(0.6, `hsla(${bubble.hue}, 85%, 62%, 0.85)`);
+  gradient.addColorStop(1, "rgba(255, 255, 255, 0.05)");
+  context.fillStyle = gradient;
+  context.arc(0, 0, bubble.radius, 0, Math.PI * 2);
+  context.fill();
+  context.lineWidth = 2;
+  context.strokeStyle = `hsla(${bubble.hue}, 90%, 90%, 0.8)`;
+  context.stroke();
+  context.beginPath();
+  context.fillStyle = "rgba(255, 255, 255, 0.6)";
+  context.ellipse(-bubble.radius * 0.3, -bubble.radius * 0.35, bubble.radius * 0.15, bubble.radius * 0.25, 0.9, 0, Math.PI * 2);
+  context.fill();
+  context.restore();
+}
