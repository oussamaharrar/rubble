diff --git a/app/api/pay/session/route.ts b/app/api/pay/session/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6604e6110f0ef4515c85ea69ab076399b7c5cc40
--- /dev/null
+++ b/app/api/pay/session/route.ts
@@ -0,0 +1,45 @@
+import { NextResponse } from "next/server";
+import { z } from "zod";
+
+import { createBasePaySession } from "@/lib/pay";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const payloadSchema = z.object({
+  sku: z.literal("booster_time_freeze").optional(),
+  amountWei: z.coerce.bigint().optional(),
+});
+
+export async function POST(request: Request) {
+  try {
+    const body = await request.json();
+    const payload = payloadSchema.parse(body ?? {});
+    const session = await createBasePaySession({
+      sku: payload.sku ?? "booster_time_freeze",
+      amountWei: payload.amountWei,
+    });
+
+    return NextResponse.json(
+      { ok: true, session },
+      {
+        status: 200,
+        headers: {
+          "cache-control": "no-store",
+        },
+      },
+    );
+  } catch (error) {
+    console.error("Failed to initialise Base Pay session", error);
+    const message = error instanceof z.ZodError ? "Invalid request payload" : "Unable to create Base Pay session";
+    return NextResponse.json(
+      { ok: false, message },
+      {
+        status: error instanceof z.ZodError ? 400 : 500,
+        headers: {
+          "cache-control": "no-store",
+        },
+      },
+    );
+  }
+}
diff --git a/app/api/pay/status/route.ts b/app/api/pay/status/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..375fd44330ce0bf68abca5d4a96ea86c587aebb8
--- /dev/null
+++ b/app/api/pay/status/route.ts
@@ -0,0 +1,54 @@
+import { NextResponse } from "next/server";
+import { z } from "zod";
+
+import { getSessionLedgerEntry, isSessionGranted } from "@/lib/pay";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const querySchema = z.object({
+  sessionId: z.string().min(1),
+});
+
+export async function GET(request: Request) {
+  const { searchParams } = new URL(request.url);
+  const parseResult = querySchema.safeParse({ sessionId: searchParams.get("sessionId") ?? "" });
+
+  if (!parseResult.success) {
+    return NextResponse.json(
+      { message: "Invalid sessionId" },
+      {
+        status: 400,
+        headers: {
+          "cache-control": "no-store",
+        },
+      },
+    );
+  }
+
+  const { sessionId } = parseResult.data;
+  const granted = isSessionGranted(sessionId);
+  const exists = Boolean(getSessionLedgerEntry(sessionId));
+
+  if (!exists) {
+    return NextResponse.json(
+      { granted: false, message: "Session not found" },
+      {
+        status: 404,
+        headers: {
+          "cache-control": "no-store",
+        },
+      },
+    );
+  }
+
+  return NextResponse.json(
+    { granted },
+    {
+      status: 200,
+      headers: {
+        "cache-control": "no-store",
+      },
+    },
+  );
+}
diff --git a/app/api/pay/webhook/route.ts b/app/api/pay/webhook/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..812e8927400cd4e732078662ea4c1e85273ee177
--- /dev/null
+++ b/app/api/pay/webhook/route.ts
@@ -0,0 +1,68 @@
+import { NextResponse } from "next/server";
+
+import {
+  markSessionGranted,
+  parseWebhookEvent,
+  signatureHeaderName,
+  validateSuccessfulPayment,
+  verifyBasePaySignature,
+} from "@/lib/pay";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+function noStoreHeaders() {
+  return {
+    "cache-control": "no-store",
+  };
+}
+
+export async function POST(request: Request) {
+  const rawBody = Buffer.from(await request.arrayBuffer());
+  const signature = request.headers.get(signatureHeaderName());
+
+  if (!verifyBasePaySignature(signature, rawBody)) {
+    return NextResponse.json(
+      { ok: false, reason: "INVALID_SIGNATURE" },
+      {
+        status: 401,
+        headers: noStoreHeaders(),
+      },
+    );
+  }
+
+  try {
+    const event = parseWebhookEvent(rawBody);
+    if (event.type !== "payment.succeeded" && event.type !== "payment.settled") {
+      return NextResponse.json(
+        { ok: true, ignored: true },
+        {
+          status: 200,
+          headers: noStoreHeaders(),
+        },
+      );
+    }
+
+    const sessionId = validateSuccessfulPayment(event);
+    markSessionGranted(sessionId);
+
+    return NextResponse.json(
+      { ok: true, sessionId },
+      {
+        status: 200,
+        headers: noStoreHeaders(),
+      },
+    );
+  } catch (error) {
+    const message = error instanceof Error ? error.message : "UNKNOWN_ERROR";
+    const status =
+      message === "UNKNOWN_SESSION" || message === "MISSING_SESSION_ID" ? 404 : message === "INVALID_JSON" ? 400 : 422;
+    return NextResponse.json(
+      { ok: false, reason: message },
+      {
+        status,
+        headers: noStoreHeaders(),
+      },
+    );
+  }
+}
