+function isWithinHud(x: number, y: number, radius: number, hud: HudBounds) {
+  if (!hud || hud.width <= 0 || hud.height <= 0) {
+    return false;
+  }
+  const pad = radius + 12;
+  const left = hud.x - pad;
+  const right = hud.x + hud.width + pad;
+  const top = hud.y - pad;
+  const bottom = hud.y + hud.height + pad;
+  return x >= left && x <= right && y >= top && y <= bottom;
+}
+
+function computeSafeInterior(
+  width: number,
+  height: number,
+  radius: number,
+  hud: HudBounds
+): { left: number; right: number; top: number; bottom: number } {
+  const marginX = Math.max(width * 0.08, 12);
+  const marginTop = Math.max(height * 0.12, 12);
+  const left = Math.max(radius + marginX, radius + 12);
+  const right = Math.max(left, width - (radius + marginX));
+  const hudBottom = hud && hud.height > 0 ? hud.y + hud.height + radius + 16 : 0;
+  const topBase = Math.max(radius + marginTop, radius + 12);
+  const top = Math.max(topBase, hudBottom);
+  const bottom = Math.max(top, height - radius - 16);
+  return { left, right, top, bottom };
