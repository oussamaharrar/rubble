+              onConnect={handleConnect}
+              onPlayTrial={handleGateTrial}
+              onOpenMore={handleOpenMore}
+            />
+
+            <MorePanel
+              open={moreOpen && screen === 'home'}
+              onClose={handleCloseMore}
+              glassBg={glassBg}
+              glassBorder={glassBorder}
+              priceMin={priceMin}
+              priceMid={priceMid}
+              priceMax={priceMax}
+              dailyClaimed={dailyClaimed}
+              inviteClaimed={inviteClaimed}
+              referral={referralCode(address ?? null)}
+              reducedMotion={shouldReduceMotion}
+              onClaimDaily={handleClaimDaily}
+              onInvite={handleInvite}
+              onShopGranted={handleShopGranted}
+            />
+
+            <ToastDisplay toast={toast} />
+
+            <SettingsModal open={settingsOpen} onClose={() => setSettingsOpen(false)} />
+            <LeaderboardModal open={leaderboardOpen} onClose={() => setLeaderboardOpen(false)} highlight={null} />
+          </div>
+        </div>
+      </div>
     </div>
   );
 }
