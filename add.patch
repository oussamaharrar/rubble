+      }).__RUBBLE_GATE__;
+      return gate ?? { walletConnected: false, trialAvailable: false, eligible: false };
+    });
+    console.log(
+      `GATE: walletConnected=${finalGate.walletConnected} trial=${finalGate.trialAvailable} eligible=${finalGate.eligible}`
+    );
